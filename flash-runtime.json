{
  "note": "Qwen3.8-Flash-Next 运行时配置。config 指向 gmlx-serve.yaml（单模型 + 前缀缓存 APC）。env 里的 APC_CHECKPOINT_INTERVAL_TOKENS 决定缓存检查点步长：该架构是混合注意力（12 qsa / 36 arr），APC 只能存检查点快照，步长即最多需要重算的 tokens 数。llama.cpp 基线保留在 ~/llama.cpp，切回只需把 engine 改成 llama.cpp。",
  "engine": "gmlx",
  "gmlx": "~/gmlx-env/bin/gmlx",
  "model": "~/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf",
  "mmproj": "~/models/qwen3.8-flash-next/mmproj-F16.gguf",
  "speculative": true,
  "draft_gguf": "~/models/flash-drafter/Qwen3.8-Flash-Next-mtp-drafter-Q4_K_L.gguf",
  "speculative_width_cap": 1,
  "host": "127.0.0.1",
  "port": 8090,
  "no_auth": true,
  "thinking": "off",
  "log": "/tmp/gmlx-flash.log",
  "served_model_id": "qwen3.8-flash-next",
  "fallback": {
    "engine": "llama.cpp",
    "binary": "~/llama.cpp/build/bin/llama-server",
    "argv": [
      "--model",
      "~/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf",
      "--mmproj",
      "~/models/qwen3.8-flash-next/mmproj-F16.gguf",
      "--alias",
      "qwen3.8-flash-125b",
      "--host",
      "127.0.0.1",
      "--port",
      "8090",
      "--api-key",
      "sk-test",
      "--ctx-size",
      "131072",
      "--image-min-tokens",
      "1024",
      "--n-gpu-layers",
      "99",
      "--jinja",
      "--threads",
      "16"
    ]
  },
  "config": "~/.ollama-token-gateway/gmlx-serve.yaml",
  "env": {
    "APC_CHECKPOINT_INTERVAL_TOKENS": "2048",
    "GMLX_APC_CKPT_HEAVY": "6",
    "GMLX_APC_CKPT_INTERVAL": "2048",
    "GMLX_APC_CKPT_BUDGET_MB": "8192"
  }
}